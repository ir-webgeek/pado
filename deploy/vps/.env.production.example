# Copy to .env (cp .env.production.example .env) and fill in. deploy.sh fills the secrets marked CHANGE_ME.

# ---- domain ----
# your domain, pointed (A record) to this server's IP; :80 for a quick test on the bare IP
DOMAIN=pado.example.ir
PUBLIC_WEB_URL=https://pado.example.ir
CORS_ORIGINS=https://pado.example.ir

# ---- secrets (deploy.sh generates them on first run) ----
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# ---- core ----
NODE_ENV=production
API_PORT=4000
OTP_DEV_ECHO=false
# mobiles that become super admins on first login (comma separated)
SUPER_ADMIN_PHONES=09120000000

# Everything below can also be set later in the panel: /admin > platform settings (values there win).

# ---- SMS (OTP login needs this in production) ----
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# verify-lookup template name for login codes (recommended; plain send is the fallback)
KAVENEGAR_OTP_TEMPLATE=

# ---- AI (Anthropic) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# ---- payments: mock (demo) until the bank gives you terminal details ----
PAYMENT_PROVIDER=mock
PASARGAD_MERCHANT_CODE=
PASARGAD_TERMINAL=
PASARGAD_PRIVATE_KEY=
PLATFORM_FEE_PERCENT=1
PLATFORM_IBAN=
# installments (TorobPay): credentials from the TorobPay merchant panel; empty = option hidden
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_USERNAME=
TOROBPAY_PASSWORD=

# ---- Instagram (Meta) ----
META_APP_SECRET=
META_VERIFY_TOKEN=CHANGE_ME
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- optional ----
TELEGRAM_BOT_TOKEN=
