# ---- core ----
NODE_ENV=development
DATABASE_URL=postgres://shopino:shopino@localhost:5432/shopino
REDIS_URL=redis://localhost:6379
API_PORT=4000
# public URL of the web app (used in payment callbacks, order / booking links)
PUBLIC_WEB_URL=http://localhost:3000
# long random strings (openssl rand -hex 32)
JWT_SECRET=change-me-change-me-change-me-change-me
COOKIE_SECRET=change-me-change-me-change-me-change-me
# in development OTP codes are printed to the API log instead of SMS
OTP_DEV_ECHO=true
# comma separated mobiles that become platform super admins (/admin) on login
SUPER_ADMIN_PHONES=09120000000

# ---- AI agent (Anthropic) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
# claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 | claude-opus-5-5; also selectable in /admin
# fixed toman per 1M tokens (input/output), used until a USD rate is set in /admin > platform settings
AGENT_PRICE_IN_PER_MTOK=500000
AGENT_PRICE_OUT_PER_MTOK=2500000

# ---- Instagram (Meta, Instagram API with Instagram Login) ----
META_APP_SECRET=
META_VERIFY_TOKEN=shopino-verify
META_GRAPH_VERSION=v25.0
# one-click "Connect with Instagram" (Business Login): App Dashboard > Instagram > API setup with Instagram login.
# Add <PUBLIC_API_URL or PUBLIC_WEB_URL/api>/v1/instagram/oauth/callback to the app's OAuth redirect URIs.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=

# ---- payments ----
# mock (demo gateway) | zarinpal | pasargad (shared gateway with split settlement, see PASARGAD_*)
PAYMENT_PROVIDER=mock
# platform commission recorded on every customer payment (split to PLATFORM_IBAN once the shared gateway is live)
PLATFORM_FEE_PERCENT=1
PLATFORM_IBAN=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PASARGAD_MERCHANT_CODE=
PASARGAD_TERMINAL=
# contents of the <RSAKeyValue> private key file from the bank
PASARGAD_PRIVATE_KEY=

# ---- SMS ----
# console (codes printed to the API log) | kavenegar
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# verify-lookup template for login codes (falls back to a plain message)
KAVENEGAR_OTP_TEMPLATE=

# ---- uploads ----
UPLOAD_DIR=./uploads

# ---- USD pricing (optional) ----
# JSON endpoint returning the USD rate; USD_RATE_JSON_PATH picks the number, multiplier converts (0.1 for Rial->Toman)
USD_RATE_URL=
USD_RATE_JSON_PATH=usd
USD_RATE_MULTIPLIER=1
